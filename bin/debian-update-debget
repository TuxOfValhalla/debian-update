#!/usr/bin/env bash
# debian-update-debget v0.7.0
set -euo pipefail

trap 'echo -e "\nExiting."; exit 0' INT TERM

BOLD="\033[1m"
GREEN="\033[1;32m"
CYAN="\033[1;36m"
YELLOW="\033[1;33m"
RESET="\033[0m"

echo -e "${CYAN}${BOLD}Debian-Update: Third-Party .deb Package Manager (deb-get)${RESET}\n"

# Verify deb-get binary
if ! command -v deb-get >/dev/null 2>&1; then
    echo "deb-get is not installed on this system."
    read -r -p "Press [ENTER] to exit..." || true
    exit 1
fi

# Main action loop
while true; do
    echo "Available actions:"
    echo " 1) List installed third-party .deb packages"
    echo " 2) Search for a package"
    echo " 3) Install a package"
    echo " 4) Update deb-get repository index"
    echo " Q) Exit"
    echo ""
    read -r -p "Select option [1-4, Q]: " CHOICE || CHOICE=""

    case "$CHOICE" in
        1)
            echo -e "\n${GREEN}Installed packages via deb-get:${RESET}"
            deb-get list || true
            ;;
        2)
            read -r -p "Enter package name to search (or ENTER to cancel): " PKG || PKG=""
            [ -n "$PKG" ] && deb-get search "$PKG" || true
            ;;
        3)
            read -r -p "Enter package name to install (or ENTER to cancel): " PKG || PKG=""
            [ -n "$PKG" ] && sudo deb-get install "$PKG" || true
            ;;
        4)
            echo -e "\n${GREEN}Updating deb-get index...${RESET}"
            sudo deb-get update || true
            ;;
        q|Q)
            echo "Exiting."
            exit 0
            ;;
        *)
            echo -e "${YELLOW}Invalid option. Please try again.${RESET}"
            ;;
    esac
    echo ""
done
