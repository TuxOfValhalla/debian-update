#!/usr/bin/env bash

# debian-update-cli v0.3.0
set -euo pipefail

BOLD="\033[1m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
RESET="\033[0m"

echo -e "${CYAN}${BOLD}Debian-Update v0.3.0${RESET}\n"

STATUS_FILE="/var/cache/debian-update/status.json"

if [ -f "$STATUS_FILE" ]; then
    echo -e "${BOLD}--- [ Pending Updates Summary ] ---${RESET}"
    python3 -c '
import json
try:
    with open("'"$STATUS_FILE"'") as f:
        d = json.load(f)
        apt = d.get("apt_updates", [])
        held = d.get("apt_held_back", [])
        fp = d.get("flatpak_updates", [])
        print(f" • APT Updates:     {len(apt)}")
        print(f" • Flatpak Updates: {len(fp)}")
        print(f" • Held Back:       {len(held)}")
except Exception:
    pass
'
    echo ""
fi

# Step 1: APT Upgrade
echo -e "${BOLD}=== Step 1/3: Upgrading APT Packages ===${RESET}"
if command -v apt-listbugs >/dev/null 2>&1; then
    echo -e "${YELLOW}Checking Debian Bug Tracking System (apt-listbugs)...${RESET}"
fi
sudo apt upgrade

# Step 2: Flatpak Upgrade
echo -e "\n${BOLD}=== Step 2/3: Upgrading Flatpak Packages ===${RESET}"
if command -v flatpak >/dev/null 2>&1; then
    flatpak update
else
    echo "Flatpak is not installed. Skipping."
fi

# Step 3: Interactive System Cleanup
echo -e "\n${BOLD}=== Step 3/3: System Cleanup & Service Inspection ===${RESET}"
read -p "Do you want to perform system cleanup (autoremove & unused flatpaks)? [y/N] " -n 1 -r REPLY
echo
if [[ "$REPLY" =~ ^[Yy]$ ]]; then
    echo -e "${GREEN}Schwing! Running package cleanup...${RESET}"
    sudo apt autoremove
    if command -v flatpak >/dev/null 2>&1; then
        flatpak uninstall --unused || true
    fi
else
    echo -e "${YELLOW}Skipping cleanup step. Party on!${RESET}"
fi

# Service Inspection via needrestart
if command -v needrestart >/dev/null 2>&1; then
    echo -e "\n${BOLD}--- [ Service Restart Inspection (needrestart) ] ---${RESET}"
    sudo needrestart -b || true
fi

# Trigger background status refresh
echo -e "\n${CYAN}Refreshing background status cache...${RESET}"
sudo systemctl start debian-update-check.service || true

echo -e "\n${GREEN}${BOLD}BODACIOUS! Upgrade complete! System is up-to-date.${RESET}\n"
read -p "Press [ENTER] to exit..."
