#!/usr/bin/env bash

export NEEDRESTART_MODE=a

CURRENT_VERSION="0.10.1"
GITHUB_REPO="tux/debian-update"

BOLD="\033[1m"
BLUE="\033[1;34m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
RESET="\033[0m"

I18N_PY="/usr/share/debian-update/lib/debian_update_i18n.py"
if [ ! -f "$I18N_PY" ]; then
    I18N_PY="$(dirname "$(readlink -f "$0")")/../lib/debian_update_i18n.py"
fi

_() {
    python3 "$I18N_PY" "$@"
}

cleanup_on_exit() {
    echo ""
    read -r -p "$(_ PRESS_ENTER_EXIT)" || true
}
trap cleanup_on_exit EXIT

check_self_update() {
    echo -e "${CYAN}$(_ CHECKING_GITHUB_UPDATES)${RESET}"
    
    local release_json
    release_json=$(curl -sSL -m 5 "https://api.github.com/repos/${GITHUB_REPO}/releases/latest" 2>/dev/null || true)
    
    if [ -z "$release_json" ]; then
        echo -e "${YELLOW}$(_ GITHUB_UNREACHABLE)${RESET}\n"
        return 0
    fi

    local latest_version deb_url
    read -r latest_version deb_url <<< "$(python3 -c '
import sys, json
try:
    d = json.loads(sys.stdin.read())
    ver = d.get("tag_name", "").lstrip("v")
    url = next((a["browser_download_url"] for a in d.get("assets", []) if a.get("name", "").endswith(".deb")), "")
    print(f"{ver} {url}")
except Exception:
    print(" ")
' <<< "$release_json")" || true

    if [ -n "${latest_version:-}" ] && [ "$latest_version" != "$CURRENT_VERSION" ] && [ -n "${deb_url:-}" ]; then
        echo -e "${GREEN}${BOLD}$(_ NEW_APP_VERSION_AVAILABLE latest="$latest_version" current="$CURRENT_VERSION")${RESET}"
        read -r -p "$(_ PROMPT_UPGRADE_APP)" REPLY || REPLY="N"
        if [[ "$REPLY" =~ ^[YyJjSsOo]$ ]]; then
            echo -e "${GREEN}$(_ DOWNLOADING_APP latest="$latest_version")${RESET}"
            local tmp_deb="/tmp/debian-update_latest.deb"
            curl -sSL -o "$tmp_deb" "$deb_url"
            
            echo -e "${GREEN}$(_ INSTALLING_PACKAGE)${RESET}"
            sudo apt install -y "$tmp_deb"
            rm -f "$tmp_deb"
            
            echo -e "\n${CYAN}${BOLD}$(_ UPGRADE_COMPLETE_RELOADING)${RESET}\n"
            exec /usr/bin/debian-update-cli "$@"
        else
            echo -e "${YELLOW}$(_ SKIPPING_APP_UPGRADE)${RESET}\n"
        fi
    else
        echo -e "${GREEN}$(_ APP_UP_TO_DATE version="$CURRENT_VERSION")${RESET}\n"
    fi
}

check_held_back_packages() {
    local held_pkgs=()

    while read -r pkg; do
        [ -n "$pkg" ] && held_pkgs+=("$pkg")
    done < <(apt-mark showhold 2>/dev/null || true)

    while read -r pkg; do
        if [ -n "$pkg" ] && [[ ! " ${held_pkgs[*]:-} " =~ " ${pkg} " ]]; then
            held_pkgs+=("$pkg")
        fi
    done < <(apt-get -s upgrade 2>/dev/null | grep -E "^  [a-zA-Z0-9]" | grep -v -E "^  (Inst|Conf)" | tr -s ' ' '\n' | grep -v '^$' || true)

    if [ ${#held_pkgs[@]} -eq 0 ]; then
        return 0
    fi

    local sim_output
    sim_output=$(apt-get -s install "${held_pkgs[@]}" 2>&1 || true)

    local has_removals=0
    if echo "$sim_output" | grep -iE "(REMOVED|REMOVING|fjernes)" >/dev/null 2>&1; then
        has_removals=1
    fi

    local has_unmet=0
    if echo "$sim_output" | grep -iE "(unmet dependencies|uoppfylte)" >/dev/null 2>&1; then
        has_unmet=1
    fi

    if [ $has_removals -eq 1 ] || [ $has_unmet -eq 1 ]; then
        echo -e "${YELLOW}$(_ HELD_SKIPPED_RISK)${RESET}"
    else
        local pkgs_str
        pkgs_str=$(IFS=", "; echo "${held_pkgs[*]}")
        echo -e "${GREEN}$(_ HELD_SAFE_OFFER packages="$pkgs_str")${RESET}"
        read -r -p "$(_ PROMPT_INSTALL_SAFE_HELD)" REPLY || REPLY="N"
        if [[ "$REPLY" =~ ^[YyJjSsOo]$ ]]; then
            sudo NEEDRESTART_MODE=a apt-get install -y "${held_pkgs[@]}"
        fi
    fi
}

main() {
    echo -e "${CYAN}${BOLD}$(_ CLI_TITLE version="$CURRENT_VERSION")${RESET}\n"

    check_self_update "$@"

    STATUS_FILE="/var/cache/debian-update/status.json"

    if [ -f "$STATUS_FILE" ]; then
        echo -e "${CYAN}${BOLD}$(_ CLI_UPDATES_HEADER)${RESET}"
        python3 -c '
import json, sys, os
sys.path.insert(0, "/usr/share/debian-update/lib")
try:
    from debian_update_i18n import _
except ImportError:
    def _(k, **kw): return k

status_file = "'"$STATUS_FILE"'"
if os.path.exists(status_file):
    try:
        with open(status_file) as f:
            d = json.load(f)
            sources = [(_("CAT_APT"), d.get("apt_updates", [])),
                       (_("CAT_FLATPAK"), d.get("flatpak_updates", [])),
                       (_("CAT_SNAP"), d.get("snap_updates", [])),
                       (_("CAT_APPIMAGES"), d.get("appimage_updates", [])),
                       (_("CAT_DEBGET"), d.get("debget_updates", [])),
                       (_("HELD_BACK_MANUAL"), d.get("apt_held_back", []))]
            has_up = False
            for name, pkgs in sources:
                if pkgs:
                    has_up = True
                    print(f"\033[1;32m{name}:\033[0m")
                    for pkg in pkgs: print(f"  • {pkg}")
            if not has_up: print(_("NO_PENDING_UPDATES"))
    except Exception: pass
'
        echo ""
    fi

    read -r -p "$(_ PROMPT_CONTINUE_UPDATES)" REPLY || REPLY="Y"
    REPLY=${REPLY:-Y}
    if [[ ! "$REPLY" =~ ^[YyJjSsOo]$ ]]; then
        echo -e "\n${YELLOW}$(_ CANCELLED_BY_USER)${RESET}"
        return 0
    fi

    echo -e "\n${CYAN}$(_ VALIDATING_ADMIN)${RESET}"
    sudo -v

    # 1. APT Packages
    echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_APT)${RESET}"
    echo -e "${GREEN}$(_ REFRESHING_APT)${RESET}"
    sudo apt update

    if command -v apt-listbugs >/dev/null 2>&1; then
        echo -e "${YELLOW}$(_ CHECKING_APT_LISTBUGS)${RESET}"
    fi

    check_held_back_packages

    sudo NEEDRESTART_MODE=a apt upgrade

    # 2. Flatpak Packages
    if command -v flatpak >/dev/null 2>&1; then
        echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_FLATPAK)${RESET}"
        flatpak update || true
    fi

    # 3. Snap Packages
    if command -v snap >/dev/null 2>&1; then
        echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_SNAP)${RESET}"
        echo -e "${GREEN}$(_ REFRESHING_SNAP)${RESET}"
        sudo snap refresh || true
    fi

    # 4. AppImages
    if command -v am >/dev/null 2>&1 || command -v appimageupdatetool >/dev/null 2>&1; then
        echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_APPIMAGES)${RESET}"
        if command -v am >/dev/null 2>&1; then
            echo -e "${GREEN}$(_ UPDATING_APPIMAGES_AM)${RESET}"
            timeout 60s am update || echo -e "${YELLOW}$(_ AM_TIMEOUT)${RESET}"
        elif command -v appimageupdatetool >/dev/null 2>&1; then
            echo -e "${GREEN}$(_ UPDATING_APPIMAGES_TOOL)${RESET}"
            local search_dirs=()
            [ -d /opt/appimages ] && search_dirs+=(/opt/appimages)
            search_dirs+=(/home/* /root)
            find "${search_dirs[@]}" -maxdepth 3 \( -name "*.AppImage" -o -name "*.appimage" \) 2>/dev/null | while read -r img; do
                [ -f "$img" ] || continue
                echo "$(_ CHECKING_APPIMAGE img="$img")"
                timeout 15s appimageupdatetool --overwrite "$img" || true
            done
        fi
    fi

    # 5. Third-Party .deb Packages (deb-get)
    if command -v deb-get >/dev/null 2>&1; then
        echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_DEBGET)${RESET}"
        echo -e "${GREEN}$(_ REFRESHING_DEBGET)${RESET}"
        sudo deb-get update >/dev/null 2>&1 || true
        timeout 60s sudo NEEDRESTART_MODE=a deb-get upgrade || echo -e "${YELLOW}$(_ DEBGET_TIMEOUT)${RESET}"
    fi

    # Maintenance & Cleanup
    echo -e "\n${BLUE}${BOLD}$(_ SYSTEM_CLEANUP_TITLE)${RESET}"
    read -r -p "$(_ PROMPT_CLEANUP)" REPLY || REPLY="N"
    if [[ "$REPLY" =~ ^[YyJjSsOo]$ ]]; then
        echo -e "${GREEN}$(_ RUNNING_CLEANUP)${RESET}"
        sudo NEEDRESTART_MODE=a apt autoremove
        if command -v flatpak >/dev/null 2>&1; then
            flatpak uninstall --unused || true
        fi
    else
        echo -e "${YELLOW}$(_ SKIPPING_CLEANUP)${RESET}"
    fi

    if command -v needrestart >/dev/null 2>&1; then
        echo -e "\n${BOLD}$(_ NEEDRESTART_TITLE)${RESET}"
        sudo needrestart -b || true
    fi

    echo -e "\n${CYAN}$(_ REFRESHING_CACHE)${RESET}"
    sudo systemctl daemon-reload >/dev/null 2>&1 || true
    sudo systemctl start --no-block debian-update-check.service || true

    echo -e "\n${GREEN}${BOLD}$(_ UPGRADE_COMPLETE_SYSTEM)${RESET}"

    if [ -f /run/reboot-required ] || [ -f /var/run/reboot-required ]; then
        echo -e "\n${YELLOW}${BOLD}$(_ REBOOT_REQUIRED_TITLE)${RESET}"
        echo -e "${YELLOW}$(_ REBOOT_REQUIRED_REASON)${RESET}\n"
        read -r -p "$(_ PROMPT_REBOOT_NOW)" REPLY || REPLY="N"
        if [[ "$REPLY" =~ ^[YyJjSsOo]$ ]]; then
            echo -e "\n${GREEN}$(_ REBOOTING_IN_5S)${RESET}"
            for i in {5..1}; do
                echo -n "$i... "
                sleep 1
            done
            echo ""
            trap - EXIT
            sudo reboot
        fi
    fi
}

main "$@"
