#!/usr/bin/env python3
import sys
import json
import os
import subprocess
import time
import re
import shutil
from PyQt5.QtWidgets import QApplication, QSystemTrayIcon, QMenu, QAction, QActionGroup
from PyQt5.QtGui import QIcon
from PyQt5.QtCore import QFileSystemWatcher, QTimer

sys.path.insert(0, "/usr/share/debian-update/lib")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
try:
    from debian_update_i18n import i18n, _
except ImportError:
    def _(key, **kwargs):
        return key

STATUS_FILE = "/var/cache/debian-update/status.json"
ICON_OK = "/usr/share/icons/hicolor/128x128/apps/debian-update-ok.png"
ICON_PENDING = "/usr/share/icons/hicolor/128x128/apps/debian-update-pending.png"
ICON_CHECKING = "/usr/share/icons/hicolor/128x128/apps/debian-update-checking.png"

def get_time_since_last_check(data):
    if not data or "last_check_ts" not in data:
        if os.path.exists(STATUS_FILE):
            try:
                mtime = os.path.getmtime(STATUS_FILE)
                diff = max(0, time.time() - mtime)
            except Exception:
                return _("UNKNOWN")
        else:
            return _("NEVER")
    else:
        try:
            diff = max(0, time.time() - float(data["last_check_ts"]))
        except Exception:
            return _("UNKNOWN")

    if diff < 60:
        return _("JUST_NOW")
    mins = int(diff // 60)
    hours = mins // 60
    days = hours // 24

    if days > 0:
        return _("AGO_DAYS_HOURS", days=days, hours=hours % 24)
    elif hours > 0:
        return _("AGO_HOURS_MINS", hours=hours, mins=mins % 60)
    else:
        return _("AGO_MINS", mins=mins)

def get_next_check_in():
    try:
        out = subprocess.check_output(
            ["systemctl", "status", "debian-update-check.timer"],
            stderr=subprocess.DEVNULL, text=True, timeout=3
        )
        for line in out.splitlines():
            if "Trigger:" in line and "left" in line:
                match = re.search(r';\s*(.*?)\s*left', line, re.IGNORECASE)
                if match:
                    raw = match.group(1).strip()
                    cleaned = re.sub(r'(\d+)\s*min', r'\1m', raw)
                    cleaned = re.sub(r'(\d+)\s*hours?', r'\1h', cleaned)
                    cleaned = re.sub(r'(\d+)\s*days?', r'\1d', cleaned)
                    return re.sub(r'(\d+)\s*sec', r'\1s', cleaned)
    except Exception:
        pass

    try:
        out = subprocess.check_output(
            ["systemctl", "list-timers", "--all"],
            stderr=subprocess.DEVNULL, text=True, timeout=3
        )
        for line in out.splitlines():
            if "debian-update-check.timer" in line:
                match = re.search(r'((?:\d+\w*\s*)+)\s+left', line, re.IGNORECASE)
                if match:
                    raw = match.group(1).strip()
                    cleaned = re.sub(r'(\d+)\s*min', r'\1m', raw)
                    cleaned = re.sub(r'(\d+)\s*hours?', r'\1h', cleaned)
                    cleaned = re.sub(r'(\d+)\s*days?', r'\1d', cleaned)
                    return re.sub(r'(\d+)\s*sec', r'\1s', cleaned)
    except Exception:
        pass

    return _("UNKNOWN")

class DebianUpdateTray(QSystemTrayIcon):
    def __init__(self, app):
        super().__init__()
        self.app = app
        self.last_notified_count = 0

        self.menu = QMenu()
        self.setContextMenu(self.menu)
        self.menu.aboutToShow.connect(self.update_ui)

        self.activated.connect(self.on_activated)

        cache_dir = os.path.dirname(STATUS_FILE)
        os.makedirs(cache_dir, exist_ok=True)

        self.watcher = QFileSystemWatcher()
        if os.path.exists(cache_dir):
            self.watcher.addPath(cache_dir)
            self.watcher.directoryChanged.connect(self.update_ui)
            self.watcher.fileChanged.connect(self.update_ui)

        self.poll_timer = QTimer()
        self.poll_timer.timeout.connect(self.update_ui)
        self.poll_timer.start(10000)

        self.update_ui()

    def on_activated(self, reason):
        if reason == QSystemTrayIcon.Trigger:
            self.launch_upgrade()

    def set_language(self, lang_code):
        # Lagre overstyring i konfigurasjonen. 
        # VIKTIG: Vi roter ALDRI med self.menu eller kaller update_ui() her!
        # Dette forhindrer Plasma fra å slette C++ minnepekere mens meny-klikket behandles.
        i18n.save_language_override(lang_code)

    def load_status(self):
        if not os.path.exists(STATUS_FILE):
            return None
        try:
            with open(STATUS_FILE, 'r') as f:
                return json.load(f)
        except (json.JSONDecodeError, OSError):
            return None

    def update_ui(self):
        data = self.load_status()
        self.menu.clear()

        apt_list = data.get("apt_updates", []) if data else []
        flatpak_list = data.get("flatpak_updates", []) if data else []
        snap_list = data.get("snap_updates", []) if data else []
        appimage_list = data.get("appimage_updates", []) if data else []
        debget_list = data.get("debget_updates", []) if data else []
        held_list = data.get("apt_held_back", []) if data else []
        reboot_req = data.get("reboot_required", False) if data else False
        sb_info = data.get("secure_boot", {}) if data else {}
        sb_warnings = sb_info.get("warnings", [])

        total_updates = len(apt_list) + len(flatpak_list) + len(snap_list) + len(appimage_list) + len(debget_list)

        # Update Icon & Tooltip
        if total_updates > 0:
            self.setIcon(QIcon(ICON_PENDING))
            tooltip = _("UPDATES_AVAILABLE", count=total_updates)
            details = []
            if apt_list: details.append(f"{_('CAT_APT')}: {len(apt_list)}")
            if flatpak_list: details.append(f"{_('CAT_FLATPAK')}: {len(flatpak_list)}")
            if snap_list: details.append(f"{_('CAT_SNAP')}: {len(snap_list)}")
            if appimage_list: details.append(f"{_('CAT_APPIMAGES')}: {len(appimage_list)}")
            if debget_list: details.append(f"{_('CAT_DEBGET')}: {len(debget_list)}")
            if details:
                tooltip += "\n• " + "\n• ".join(details)
            if held_list: tooltip += f"\n• " + _("TOOLTIP_HELD", count=len(held_list))
            if reboot_req: tooltip += "\n" + _("TOOLTIP_REBOOT")
            if sb_warnings: tooltip += "\n" + _("TOOLTIP_WARNINGS", count=len(sb_warnings))
            self.setToolTip(tooltip)
        else:
            self.setIcon(QIcon(ICON_OK))
            self.setToolTip(_("SYSTEM_UP_TO_DATE"))

        # Desktop Notification
        if total_updates > 0 and total_updates != self.last_notified_count:
            self.showMessage(_("DEBIAN_UPDATE_TITLE"), _("UPDATES_AVAILABLE_COUNT", count=total_updates), self.icon(), 5000)
            self.last_notified_count = total_updates
        elif total_updates == 0:
            self.last_notified_count = 0

        # 1. Top Submenu: Updates available (N)
        pending_menu = self.menu.addMenu(_("UPDATES_AVAILABLE", count=total_updates))

        if total_updates > 0:
            pipeline = [
                (_("CAT_APT"), apt_list),
                (_("CAT_FLATPAK"), flatpak_list),
                (_("CAT_SNAP"), snap_list),
                (_("CAT_APPIMAGES"), appimage_list),
                (_("CAT_DEBGET"), debget_list)
            ]

            for title, pkgs in pipeline:
                if pkgs:
                    pending_menu.addSection(f"{title} ({len(pkgs)})")
                    for pkg in pkgs:
                        action = QAction(f"  {pkg}", self)
                        action.setEnabled(False)
                        pending_menu.addAction(action)

            if held_list:
                pending_menu.addSection(_("HELD_BACK_MANUAL"))
                for pkg in held_list:
                    action = QAction(f"  {pkg}", self)
                    action.setEnabled(False)
                    pending_menu.addAction(action)
        else:
            no_up = QAction(_("ALL_PACKAGES_UP_TO_DATE"), self)
            no_up.setEnabled(False)
            pending_menu.addAction(no_up)

        if sb_warnings:
            self.menu.addSeparator()
            warn_menu = self.menu.addMenu(_("SECURITY_WARNINGS", count=len(sb_warnings)))
            for w in sb_warnings:
                w_action = QAction(f"  {w}", self)
                w_action.setEnabled(False)
                warn_menu.addAction(w_action)

        # 2. Timers
        time_since = get_time_since_last_check(data)
        next_in = get_next_check_in()

        last_action = QAction(_("TIME_SINCE_LAST_CHECK", time=time_since), self)
        last_action.setEnabled(False)
        self.menu.addAction(last_action)

        next_action = QAction(_("NEXT_CHECK_IN", time=next_in), self)
        next_action.setEnabled(False)
        self.menu.addAction(next_action)

        self.menu.addSeparator()

        # 3. Actions
        check_action = QAction(_("CHECK_FOR_UPDATES"), self)
        check_action.triggered.connect(self.trigger_check)
        self.menu.addAction(check_action)

        upgrade_action = QAction(_("UPDATE_NOW"), self)
        upgrade_action.triggered.connect(self.launch_upgrade)
        self.menu.addAction(upgrade_action)

        debget_action = QAction(_("GET_DEB_FILES"), self)
        debget_action.triggered.connect(self.launch_debget)
        self.menu.addAction(debget_action)

        self.menu.addSeparator()

        # 4. Language Selector Submenu
        lang_menu = self.menu.addMenu(_("LANGUAGE_SELECTION"))
        group = QActionGroup(self)
        group.setExclusive(True)

        sys_action = QAction(_("SYSTEM_DEFAULT_LANG"), self)
        sys_action.setCheckable(True)
        if not i18n.manual_override:
            sys_action.setChecked(True)
        sys_action.triggered.connect(lambda: self.set_language("system"))
        group.addAction(sys_action)
        lang_menu.addAction(sys_action)
        lang_menu.addSeparator()

        avail_langs = i18n.get_available_languages()
        for code, name in avail_langs.items():
            l_action = QAction(name, self)
            l_action.setCheckable(True)
            if i18n.manual_override == code:
                l_action.setChecked(True)
            l_action.triggered.connect(lambda checked, c=code: self.set_language(c))
            group.addAction(l_action)
            lang_menu.addAction(l_action)

        self.menu.addSeparator()

        # 5. Quit
        quit_action = QAction(_("QUIT"), self)
        quit_action.triggered.connect(self.app.quit)
        self.menu.addAction(quit_action)

    def trigger_check(self):
        self.setIcon(QIcon(ICON_CHECKING))
        self.setToolTip(_("CHECKING_FOR_UPDATES"))
        self.app.processEvents()
        try:
            subprocess.Popen(["sudo", "systemctl", "start", "--no-block", "debian-update-check.service"])
        except Exception:
            pass

    def launch_debget(self):
        self.launch_in_terminal(["/usr/bin/debian-update-debget"], "Debian-Update: Third-Party .deb Manager")

    def launch_upgrade(self):
        self.launch_in_terminal(["/usr/bin/debian-update-cli"], "Debian-Update")

    def launch_in_terminal(self, cmd, title):
        term = os.environ.get("TERMINAL")
        if term and shutil.which(term):
            try:
                subprocess.Popen([term, "-e"] + cmd)
                return
            except Exception:
                pass

        if shutil.which("x-terminal-emulator"):
            try:
                subprocess.Popen(["x-terminal-emulator", "-e"] + cmd)
                return
            except Exception:
                pass

        for fallback in ["konsole", "gnome-terminal", "ptyxis", "xfce4-terminal", "xterm"]:
            if shutil.which(fallback):
                try:
                    subprocess.Popen([fallback, "-e"] + cmd)
                    return
                except Exception:
                    continue

if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    app.setApplicationName("debian-update")
    app.setDesktopFileName("debian-update-tray")

    tray = DebianUpdateTray(app)
    tray.show()
    sys.exit(app.exec_())
