#!/usr/bin/env bash

# debian-update-cli v0.2.0
# Interactive CLI tool for upgrading Debian (Testing/Sid) & Flatpak packages safely.

set -euo pipefail

# Set terminal window and tab title (OSC escape sequences for Xterm/Konsole)
printf "\033]0;Debian-Update\007\033]30;Debian-Update\007"

# ANSI Color Palette
DEBIAN_RED='\033[38;2;215;10;83m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${BOLD}Debian-Update v0.2.0${NC}\n"

# Capture list of pending upgradable packages prior to upgrade for reboot analysis
UPGRADABLE_PKGS_BEFORE=$(apt list --upgradable 2>/dev/null | grep -v "Listing..." | cut -d'/' -f1 || true)

# 1. Package Preview (APT & Flatpak)
echo -e "${BLUE}${BOLD}--- [ APT Packages Pending Upgrade ] ---${NC}"
APT_OUT=$(apt list --upgradable 2>/dev/null | grep -v "Listing..." || true)
if [ -n "$APT_OUT" ]; then
    echo -e "$APT_OUT"
else
    echo "No APT packages require upgrading."
fi

echo ""
echo -e "${BLUE}${BOLD}--- [ Flatpak Applications Pending Upgrade ] ---${NC}"
FLATPAK_OUT=""
if command -v flatpak &>/dev/null; then
    FLATPAK_OUT=$(flatpak remote-ls --updates 2>/dev/null || true)
    if [ -n "$FLATPAK_OUT" ]; then
        echo -e "$FLATPAK_OUT"
    else
        echo "No Flatpak updates available."
    fi
else
    echo "Flatpak is not installed."
fi
echo ""

# Exit early if no updates are available
if [ -z "${APT_OUT// }" ] && [ -z "${FLATPAK_OUT// }" ]; then
    echo -e "${DEBIAN_RED}${BOLD}System is up to date!${NC}\n"
    read -p "Press [ENTER] to exit..."
    exit 0
fi

# 2. Check Debian Bug Tracking System (apt-listbugs)
echo -e "${YELLOW}${BOLD}--- [ Checking Debian Bug Tracking System (apt-listbugs) ] ---${NC}"
if command -v apt-listbugs &>/dev/null; then
    UPGRADABLE_PKGS=$(echo "$UPGRADABLE_PKGS_BEFORE" | tr '\n' ' ')
    if [ -n "${UPGRADABLE_PKGS// }" ]; then
        sudo apt-listbugs list ${UPGRADABLE_PKGS} || true
    else
        echo "No APT packages pending bug check."
    fi
else
    echo -e "${YELLOW}Notice: 'apt-listbugs' is not installed. Consider installing it for extra Sid/Testing safety.${NC}"
fi

echo ""
echo -e "${GREEN}${BOLD}=== Step 1/3: Upgrading APT Packages ===${NC}"
sudo apt upgrade

echo ""
echo -e "${YELLOW}${BOLD}--- [ Checking for Held-Back Packages ] ---${NC}"
HELD_BACK=$(apt-get -s upgrade 2>/dev/null | grep -A 100 "The following packages have been kept back:" | grep -E "^  " || true)
if [ -n "$HELD_BACK" ]; then
    echo -e "${DEBIAN_RED}${BOLD}[WARNING] The following packages were held back and require MANUAL INTERVENTION:${NC}"
    echo -e "$HELD_BACK"
    echo -e "${YELLOW}Tip: Dependencies for these packages changed in Testing/Sid. Inspect with 'apt-cache policy <pkg>' before upgrading.${NC}"
else
    echo -e "${GREEN}No packages were held back.${NC}"
fi

echo ""
echo -e "${GREEN}${BOLD}=== Step 2/3: Upgrading Flatpak Packages ===${NC}"
if command -v flatpak &>/dev/null; then
    flatpak update
else
    echo "Flatpak is not installed."
fi

echo ""
echo -e "${GREEN}${BOLD}=== Step 3/3: System Cleanup & Service Inspection ===${NC}"
echo "Removing orphan dependencies and clearing cache..."
sudo apt autoremove --purge -y
sudo apt autoclean -y

if command -v flatpak &>/dev/null; then
    flatpak uninstall --unused -y
fi

echo ""
echo -e "${BLUE}${BOLD}--- [ Service Restart Inspection (needrestart) ] ---${NC}"
if command -v needrestart &>/dev/null; then
    sudo needrestart -r a || true
else
    echo "Tip: Install 'needrestart' to automatically restart services updated in background."
fi

# Refresh background status JSON cache after upgrade
echo ""
echo "Refreshing background status cache..."
sudo /usr/share/debian-update/lib/check_backend.sh || true

# 3. Reboot Requirement Analysis (NVIDIA, KDE Plasma, Glibc, Kernel, Systemd)
REBOOT_REASONS=()

# Check standard system reboot flag
if [ -f /var/run/reboot-required ]; then
    REBOOT_REASONS+=("Core system components updated (/var/run/reboot-required).")
fi

# Check NVIDIA driver kernel module version mismatch
if lsmod | grep -q "^nvidia "; then
    LOADED_NV=$(modinfo -F version nvidia 2>/dev/null || true)
    INSTALLED_NV=$(dpkg-query -W -f='${Version}\n' nvidia-driver 2>/dev/null | cut -d'-' -f1 || dpkg-query -W -f='${Version}\n' nvidia-kernel-dkms 2>/dev/null | cut -d'-' -f1 || true)
    if [ -n "$LOADED_NV" ] && [ -n "$INSTALLED_NV" ] && [ "$LOADED_NV" != "$INSTALLED_NV" ]; then
        REBOOT_REASONS+=("NVIDIA GPU driver mismatch: Loaded module (${LOADED_NV}) vs Installed package (${INSTALLED_NV}).")
    fi
fi
if echo "$UPGRADABLE_PKGS_BEFORE" | grep -qE "^(nvidia-driver|nvidia-kernel-open-dkms|nvidia-kernel-dkms|xserver-xorg-video-nvidia)$"; then
    REBOOT_REASONS+=("NVIDIA graphics driver suite was updated.")
fi

# Check KDE Plasma version jump / desktop components update
if echo "$UPGRADABLE_PKGS_BEFORE" | grep -qE "^(plasma-desktop|plasma-workspace|kwin-wayland|kwin-x11)$"; then
    REBOOT_REASONS+=("KDE Plasma desktop environment components were updated.")
fi

# Check Glibc / Kernel / Systemd updates
if echo "$UPGRADABLE_PKGS_BEFORE" | grep -qE "^(libc6|glibc|linux-image-[0-9].*|systemd)$"; then
    REBOOT_REASONS+=("Critical system libraries/kernel (glibc/kernel/systemd) were updated.")
fi

echo ""
if [ ${#REBOOT_REASONS[@]} -gt 0 ]; then
    echo -e "${DEBIAN_RED}${BOLD}====================================================${NC}"
    echo -e "${DEBIAN_RED}${BOLD}           SYSTEM REBOOT RECOMMENDED!              ${NC}"
    echo -e "${DEBIAN_RED}${BOLD}====================================================${NC}"
    echo -e "${DEBIAN_RED}The following critical updates require a system reboot:${NC}"
    for reason in "${REBOOT_REASONS[@]}"; do
        echo -e "${DEBIAN_RED} • ${reason}${NC}"
    done
    echo ""
    read -p "$(echo -e "${DEBIAN_RED}${BOLD}Would you like to reboot the system now? [y/N]: ${NC}")" REBOOT_CHOICE
    case "$REBOOT_CHOICE" in
        [Yy]*)
            echo ""
            echo -e "${DEBIAN_RED}${BOLD}Rebooting system in:${NC}"
            for i in 5 4 3 2 1; do
                echo -e "${DEBIAN_RED}${BOLD}${i}...${NC}"
                sleep 1
            done
            echo -e "${DEBIAN_RED}${BOLD}Rebooting now!${NC}"
            sudo reboot
            ;;
        *)
            echo -e "${DEBIAN_RED}${BOLD}Reboot postponed. Please restart your system when convenient.${NC}"
            ;;
    esac
else
    echo -e "${DEBIAN_RED}${BOLD}Upgrade complete! System is up-to-date.${NC}"
fi

echo ""
read -p "Press [ENTER] to exit..."
